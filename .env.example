# Скопируйте этот файл в .env.local для локальной разработки
# и добавьте те же переменные в настройках проекта на Vercel
# (Project -> Settings -> Environment Variables)
# Важно: URL должен быть в формате https://<project-ref>.supabase.co
# без суффикса /rest/v1/

NEXT_PUBLIC_SUPABASE_URL='https://<your-project-ref>.supabase.co'
NEXT_PUBLIC_SUPABASE_ANON_KEY='<your-anon-key>'

# Опционально: пароль для доступа к монитору кухни/бармена и странице QR
# (простая защита, см. README)
NEXT_PUBLIC_STAFF_PASSCODE=1234
